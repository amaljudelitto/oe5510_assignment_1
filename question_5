
# 0. Define grid dimensions
r = 10

# 1. Choose a target snapshot to predict (e.g., index 100)
target_index = 100

# 2. Isolate the initial state vectors (w_1 corresponds to index 0)
wx_0 = Wx_full[:, 0]
wy_0 = Wy_full[:, 0]

# 3. Advance the state from time 0 to target_index using matrix exponentiation
Ax_powered = np.linalg.matrix_power(Ax, target_index)
Ay_powered = np.linalg.matrix_power(Ay, target_index)

wx_pred = Ax_powered @ wx_0
wy_pred = Ay_powered @ wy_0

# 4. Reconstruct the spatial flow field from the predicted amplitudes
X_pred_flat = np.real(Ux[:, :r] @ wx_pred)
Y_pred_flat = np.real(Uy[:, :r] @ wy_pred)

# 5. Extract the true fields for comparison
X_true_flat = Xvel[:, target_index]
Y_true_flat = Yvel[:, target_index]

# 6. Reshape to the physical 2D grid
X_pred_2d = X_pred_flat.reshape((n_rows, n_cols), order='F')
X_true_2d = X_true_flat.reshape((n_rows, n_cols), order='F')

Y_pred_2d = Y_pred_flat.reshape((n_rows, n_cols), order='F')
Y_true_2d = Y_true_flat.reshape((n_rows, n_cols), order='F')

