for m in m_values:

    # X velocity
    X_pred, error_x, radius_x, A_test_x = compute_prediction(
        Ux,
        Sx,
        Vhx,
        Xvel,
        m,
        target_index
    )

    # Y velocity
    Y_pred, error_y, radius_y, A_test_y = compute_prediction(
        Uy,
        Sy,
        Vhy,
        Yvel,
        m,
        target_index
    )

    # Store results
    prediction_errors_x.append(error_x)
    prediction_errors_y.append(error_y)

    spectral_radii_x.append(radius_x)
    spectral_radii_y.append(radius_y)

    predicted_fields_x[m] = X_pred
    predicted_fields_y[m] = Y_pred

    print(f"\nm = {m}")
