# BONUS QUESTION
# Effect of different numbers of retained modes on prediction

# Test different values of m (number of retained SVD modes)
m_values = [2, 3, 5, 10, 15, 20, 30, 40, 50]

# Choose a future snapshot to predict
target_index = 100

prediction_errors_x = []
prediction_errors_y = []

# FUNCTION TO BUILD THE DYNAMICAL MODEL FOR A GIVEN m

def compute_prediction(U, S, Vh, data_matrix, m, target_index):

    # 1. Construct W = Sigma_m V_m^*
    W_full = S[:m, np.newaxis] * Vh[:m, :]

    # 2. Construct W and W'
    W = W_full[:, :-1]
    W_prime = W_full[:, 1:]

    # 3. Compute best-fit dynamical matrix A
    A = W_prime @ np.linalg.pinv(W)

    # 4. Initial state
    w0 = W_full[:, 0]

    # 5. Predict target snapshot
    A_power = np.linalg.matrix_power(A, target_index)

    w_pred = A_power @ w0

    # 6. Reconstruct predicted flow field
    predicted_field = np.real(U[:, :m] @ w_pred)

    # 7. True flow field
    true_field = data_matrix[:, target_index]

    # 8. Relative prediction error
    error = (
        np.linalg.norm(
            true_field - predicted_field
        ) ** 2
        /
        np.linalg.norm(
            true_field
        ) ** 2
    )

    # 9. Eigenvalues for stability analysis
    eigenvalues = np.linalg.eigvals(A)
    spectral_radius = np.max(np.abs(eigenvalues))

    return predicted_field, error, spectral_radius, A


# TEST DIFFERENT VALUES OF m

print("BONUS: EFFECT OF NUMBER OF MODES ON PREDICTION")

spectral_radii_x = []
spectral_radii_y = []

predicted_fields_x = {}
