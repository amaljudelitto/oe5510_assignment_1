# 3. COMPUTE ENERGY

# Energy associated with each singular value:
# E_i = sigma_i^2

energy_x = Sx ** 2
energy_y = Sy ** 2


# Total energy

total_energy_x = np.sum(energy_x)
total_energy_y = np.sum(energy_y)


# Cumulative energy

cumulative_energy_x = (
    np.cumsum(energy_x) /
    total_energy_x
)

cumulative_energy_y = (
    np.cumsum(energy_y) /
    total_energy_y
)


# 4. FIND r FOR 90%, 99%, AND 99.9%

def find_r(cumulative_energy, target):

    return np.searchsorted(
        cumulative_energy,
        target
    ) + 1


r90_x = find_r(cumulative_energy_x, 0.90)
r99_x = find_r(cumulative_energy_x, 0.99)
r999_x = find_r(cumulative_energy_x, 0.999)

r90_y = find_r(cumulative_energy_y, 0.90)
r99_y = find_r(cumulative_energy_y, 0.99)
r999_y = find_r(cumulative_energy_y, 0.999)


