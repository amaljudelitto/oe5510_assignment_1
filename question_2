# 12. FUNCTION TO PLOT A FLOW FIELD
# ------------------------------------------------------------
def plot_flow_snapshot(matrix, snapshot, title, n_rows=199, n_cols=449):
    # CRITICAL FIX: order='F' ensures the MATLAB data reshapes correctly
    field = matrix[:, snapshot].reshape((n_rows, n_cols), order='F')

    plt.figure(figsize=(12, 5))
    # Added a diverging colormap for better visual contrast of velocity
    plt.imshow(field, origin='lower', aspect='auto', cmap='RdBu') 
    plt.colorbar(label='Velocity')
    plt.xlabel("x")
    plt.ylabel("y")
    plt.title(title)
    plt.tight_layout()
    plt.show()


