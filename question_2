# 9. TRUNCATED SVD RECONSTRUCTION FUNCTION

def reconstruct(U, S, Vh, r):

    Ur = U[:, :r]
    Sr = S[:r]
    Vhr = Vh[:r, :]

    # U_r Sigma_r V_r^*
    reconstructed = (
        Ur *
        Sr[np.newaxis, :]
    ) @ Vhr

    return reconstructed

# 10. CALCULATE RECONSTRUCTION ERRORS
r_values_x = [r90_x, r99_x, r999_x]
r_values_y = [r90_y, r99_y, r999_y]

print("\n" + "=" * 60)
print("RECONSTRUCTION ERRORS")
print("=" * 60)

# Store reconstructed matrices and errors to avoid recalculating later
reconstructed_x, reconstructed_y = {}, {}
errors_x, errors_y = [], []

# X Velocity Errors
for r in r_values_x:
    Xr = reconstruct(Ux, Sx, Vhx, r)
    reconstructed_x[r] = Xr
    
    error = np.linalg.norm(Xvel - Xr, 'fro') ** 2
    errors_x.append(error)  # Save for plotting
    
    relative_error = error / total_energy_x
    
    print(f"\nX velocity, r = {r}")
    print(f"Squared Frobenius error = {error:.6e}")
    print(f"Relative squared error = {relative_error:.6%}")

# Y Velocity Errors
for r in r_values_y:
    Yr = reconstruct(Uy, Sy, Vhy, r)
    reconstructed_y[r] = Yr
    
    error = np.linalg.norm(Yvel - Yr, 'fro') ** 2
    errors_y.append(error)  # Save for plotting
    
    relative_error = error / total_energy_y
    
    print(f"\nY velocity, r = {r}")
    print(f"Squared Frobenius error = {error:.6e}")
    print(f"Relative squared error = {relative_error:.6%}")


